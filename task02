#include<stdio.h>
#include<stdlib.h>
int main(){
  int *rollno,*marks,n;
    float avg=0;
     printf("enter the total no of student");
    scanf("%d",&n);
    rollno=(int*)calloc(n,sizeof(int));
    marks=(int*)calloc(n,sizeof(int));
    if(rollno==NULL && marks==NULL){
        printf("memory allocation failed");
    }
    else{
        printf("memory allocation successfully");
        for(int i=0;i<n;i++){
            printf("student %d",i+1);
            printf("enter roll no");
            scanf("%d",&rollno[i]);
            printf("enter marks");
            scanf("%d",&marks[i]);
         avg+=marks[i];
        }
            avg=avg/n;
        for(int i=0;i<n;i++){
            printf("roll no %d marks %d",rollno[i],marks[i]);
        }
        printf("avg marks is %d",avg);
        free(rollno);
        free(marks);
    }
}
    
    
  
    
